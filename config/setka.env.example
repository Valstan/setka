# SETKA example environment (DO NOT put real secrets in git)
#
# Copy to a secure location (e.g. /etc/setka/setka.env) and load via your process manager (systemd, supervisor, etc.)

# Required
DATABASE_URL=postgresql+asyncpg://setka_user:CHANGE_ME@localhost:5432/setka
REDIS_URL=redis://localhost:6379/0

# Optional: VK tokens (any number). Names are mapped from suffix: VK_TOKEN_VALSTAN -> "VALSTAN"
VK_TOKEN_VALSTAN=vk1.a.CHANGE_ME
VK_TOKEN_VITA=vk1.a.CHANGE_ME

# Optional: Telegram
TELEGRAM_TOKEN_VALSTANBOT=CHANGE_ME
TELEGRAM_ALERT_CHAT_ID=CHANGE_ME

# Optional: server info (used for building dashboard URLs in notifications)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Optional: DB pool (Celery + uvicorn each have a pool; keep totals under Postgres max_connections)
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=3600

# Сетевой хаб copy/setka (расписание :07 и :37): стена по умолчанию vk.com/copy_by_setka (-167381590)
# Режим: если в тексте поста есть слово «репост» — wall.repost вложенного поста; иначе копия текста+вложений.
# COPY_SETKA_SOURCE_GROUP_ID=-167381590
# COPY_SETKA_DISABLED=0
# COPY_SETKA_REPOST_MESSAGE=
# COPY_SETKA_MAX_POST_AGE_HOURS=48
# COPY_SETKA_TARGET_REGION_CODES=pizhanka,ur

# Optional: AI (нейро-движок экосистемы — DeepSeek, D-024).
# В норме ключ лежит только в комнате КАРМАНа и на прод-бокс не кладётся.
DEEPSEEK_API_KEY=CHANGE_ME

# ВК-бот кабинета рекламодателя: сообщество «САРАФАН» (положительный id); токен — в /tokens
SARAFAN_VK_COMMUNITY_ID=

# Кэш стен ВК (2026-09-22): одна стена читается один раз, а не каждой
# подсистемой заново. Хранится в Redis db=1, fail-open (Redis лёг → читаем ВК
# как раньше). Ноль выключает слой целиком — откат без деплоя.
#   WALL_CACHE_TTL_SECONDS — донорские стены. ВЫКЛЮЧЕНО (0) по замеру
#     22.09: доля попаданий 2.3 % (11 против 474) при росте пика памяти Redis
#     с 5.3 до 37.9 МБ. Районы идут по очереди в одном процессе, доноры у
#     каждого свои — повторного чтения одной стены почти не случается, и
#     увеличение окна поднимает не попадания, а резидентную память.
#   WALL_HISTORY_CACHE_TTL_SECONDS — своя ИНФО-стена района. Хранится не
#     снимок стены, а РЕЗУЛЬТАТ: список lip'ов источников из наших же сводок
#     (килобайты вместо мегабайта). Снимок упирался в потолок записи и молча не
#     кэшировался вовсе — нашлось замером в Redis, не чтением кода. Шесть
#     часов: запись весит ~2 КБ (замер: 2054 Б), все 57 районов ~114 КБ, а
#     протухнуть ей нечему — историю сбрасывает сама публикация в эту стену.
#   WALL_CACHE_MAX_ENTRY_BYTES — потолок одной записи; стена жирнее просто не
#     кэшируется (промах дешевле разросшегося Redis).
# WALL_CACHE_TTL_SECONDS=0
# WALL_HISTORY_CACHE_TTL_SECONDS=21600
# WALL_CACHE_MAX_ENTRY_BYTES=262144

# Запасной путь: у темы нет своих сообществ → читать весь пул района.
# ВКЛЮЧЕНО по умолчанию и выключать нельзя бездумно: на нём целиком держится
# тема addons (своих сообществ нет ни у одного района, 1752 публикации за
# 7 дней) — см. docs/pending/P180. Флаг для замера и аварии, не для экономии.
# PARSE_THEME_FALLBACK_ALL_COMMUNITIES=1
